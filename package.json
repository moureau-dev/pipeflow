{
  "name": "@moureau/pipeflow",
  "version": "0.0.1",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": "Luiz Felipe Moureau",
  "repository": {
    "type": "git",
    "url": "https://github.com/moureau-dev/pipeflow.git"
  },
  "bugs": {
    "url": "https://github.com/moureau-dev/pipeflow/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./providers": {
      "types": "./dist/types/providers/index.d.ts",
      "import": "./dist/esm/providers/index.js",
      "require": "./dist/cjs/providers/index.js",
      "default": "./dist/esm/providers/index.js"
    },
    "./providers/*": {
      "types": "./dist/types/providers/*/index.d.ts",
      "import": "./dist/esm/providers/*/index.js",
      "require": "./dist/cjs/providers/*/index.js",
      "default": "./dist/esm/providers/*/index.js"
    },
    "./persistence": {
      "types": "./dist/types/persistence/index.d.ts",
      "import": "./dist/esm/persistence/index.js",
      "require": "./dist/cjs/persistence/index.js",
      "default": "./dist/esm/persistence/index.js"
    },
    "./persistence/*": {
      "types": "./dist/types/persistence/*/index.d.ts",
      "import": "./dist/esm/persistence/*/index.js",
      "require": "./dist/cjs/persistence/*/index.js",
      "default": "./dist/esm/persistence/*/index.js"
    },
    "./transport": {
      "types": "./dist/types/transport/index.d.ts",
      "import": "./dist/esm/transport/index.js",
      "require": "./dist/cjs/transport/index.js",
      "default": "./dist/esm/transport/index.js"
    },
    "./transport/*": {
      "types": "./dist/types/transport/*/index.d.ts",
      "import": "./dist/esm/transport/*/index.js",
      "require": "./dist/cjs/transport/*/index.js",
      "default": "./dist/esm/transport/*/index.js"
    },
    "./conversations": {
      "types": "./dist/types/conversations/index.d.ts",
      "import": "./dist/esm/conversations/index.js",
      "require": "./dist/cjs/conversations/index.js",
      "default": "./dist/esm/conversations/index.js"
    },
    "./conversations/*": {
      "types": "./dist/types/conversations/*/index.d.ts",
      "import": "./dist/esm/conversations/*/index.js",
      "require": "./dist/cjs/conversations/*/index.js",
      "default": "./dist/esm/conversations/*/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:e2e": "bun test src/e2e",
    "benchmark": "bun scripts/benchmark.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
