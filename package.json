{
  "name": "pipeflow",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./providers": {
      "types": "./dist/types/providers/index.d.ts",
      "import": "./dist/esm/providers/index.js",
      "require": "./dist/cjs/providers/index.js",
      "default": "./dist/esm/providers/index.js"
    },
    "./providers/*": {
      "types": "./dist/types/providers/*/index.d.ts",
      "import": "./dist/esm/providers/*/index.js",
      "require": "./dist/cjs/providers/*/index.js",
      "default": "./dist/esm/providers/*/index.js"
    },
    "./persistence": {
      "types": "./dist/types/persistence/index.d.ts",
      "import": "./dist/esm/persistence/index.js",
      "require": "./dist/cjs/persistence/index.js",
      "default": "./dist/esm/persistence/index.js"
    },
    "./persistence/*": {
      "types": "./dist/types/persistence/*/index.d.ts",
      "import": "./dist/esm/persistence/*/index.js",
      "require": "./dist/cjs/persistence/*/index.js",
      "default": "./dist/esm/persistence/*/index.js"
    },
    "./transport": {
      "types": "./dist/types/transport/index.d.ts",
      "import": "./dist/esm/transport/index.js",
      "require": "./dist/cjs/transport/index.js",
      "default": "./dist/esm/transport/index.js"
    },
    "./transport/*": {
      "types": "./dist/types/transport/*/index.d.ts",
      "import": "./dist/esm/transport/*/index.js",
      "require": "./dist/cjs/transport/*/index.js",
      "default": "./dist/esm/transport/*/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
