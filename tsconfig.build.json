{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Declaration-only emit for the published types.
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist/types",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/persistence/contract-tests.ts"]
}
